#!/usr/bin/env python3
# ─────────────────────────────────────────────────────────────────────────────
# veltrix-hijri-date — print today's Hijri date for the menu bar.
#
#   veltrix-hijri-date [--offset -1|0|1] [--date YYYY-MM-DD]
#   →  19 Jumada al-Akhirah 1447
#
# Called by the shell's HijriService (ui/shell/core/HijriService.ts) once a
# minute, by bare name, like the shell's other helpers (veltrix-language,
# veltrix-lock). Installed to /usr/bin by the package (PKGBUILD bin list) and
# by install.sh §5.
#
# Conversion is `hijridate` (PyPI, MIT, zero dependencies, fully offline):
# the Umm al-Qura calendar table, 1343–1500 AH. No network, no file writes,
# no state — one line on stdout, nothing else.
#
# --offset is the moon-sighting adjustment (ARCHITECTURE.md §5 I2): Umm
# al-Qura is calculated, and a real month can start a day earlier or later
# than the table says, so the person may shift the shown date by −1 / 0 /
# +1 day. The offset is applied to the GREGORIAN date first and the shifted
# date is then converted, which is how the shift stays correct across a
# month boundary. It lives in GSettings org.veltrix.region `hijri-offset`
# and is set from Settings → Top bar → Clock → Configure.
#
# Install: the `hijridate` data lives in a per-user venv, NOT in the system
# python. `hijridate` has no Arch package, and Arch blocks `pip install
# --user` (PEP 668, externally-managed-environment) — `pip install --user
# hijridate` fails on Arch, and `--break-system-packages` is never the
# answer. install.sh creates `~/.local/share/veltrix/venv` with
# `hijridate==2.6.0` pinned (fail-soft: without network the install still
# succeeds and the bar shows the Gregorian clock only). This helper re-execs
# itself under that venv python when the system python lacks the import (see
# _try_venv); a future packaged venv at /usr/share/veltrix/venv is the
# second candidate (Phase 11). No Arch package name is recorded here on
# purpose: no `python-hijridate` package could be verified against a live
# source, and naming one would be a guess that breaks `pacman -S veltrix`
# (same rule as WhiteSur in the PKGBUILD). Check `yay -Ss hijridate` on the
# Dell before promising a pacman name.
#
# Exit codes: 0 = printed a date; 2 = bad arguments (argparse); 3 =
# `hijridate` is not installed — the shell treats this as "no Hijri data"
# and shows the Gregorian clock only, never a fake date; 4 = the date is
# outside hijridate's table (before 1343 AH / after 1500 AH).
# ─────────────────────────────────────────────────────────────────────────────

import argparse
import os
import sys
from datetime import date, timedelta


def _try_venv():
    """Re-exec this helper under the Veltrix venv python.

    Called only when the system python cannot import `hijridate`. The venv
    candidates, in order: the per-user venv install.sh creates, then a future
    packaged venv (Phase 11). The VELTRIX_HIJRI_VENV_TRIED guard stops a loop
    if the venv python lacks the import too — in that case this returns False
    and the caller exits 3 (no Hijri data), never a fake date.
    """
    if os.environ.get("VELTRIX_HIJRI_VENV_TRIED"):
        return False
    candidates = [
        os.path.expanduser("~/.local/share/veltrix/venv/bin/python"),
        "/usr/share/veltrix/venv/bin/python",
    ]
    for py in candidates:
        if os.path.isfile(py) and os.access(py, os.X_OK):
            os.environ["VELTRIX_HIJRI_VENV_TRIED"] = "1"
            os.execv(py, [py, sys.argv[0], *sys.argv[1:]])
    return False


def parse_args(argv):
    p = argparse.ArgumentParser(
        description="Print today's Hijri date (Umm al-Qura, offline).")
    p.add_argument("--offset", type=int, choices=(-1, 0, 1), default=0,
                   help="moon-sighting adjustment in days (default: 0)")
    p.add_argument("--date", default=None, metavar="YYYY-MM-DD",
                   help="Gregorian date to convert (default: today; for testing)")
    args = p.parse_args(argv)
    if args.date is None:
        args.gregorian = date.today()
    else:
        try:
            y, m, d = (int(part) for part in args.date.split("-"))
            args.gregorian = date(y, m, d)
        except ValueError:
            p.error("--date must be YYYY-MM-DD")
    return args


def main(argv):
    args = parse_args(argv)
    try:
        from hijridate import Gregorian
    except ImportError:
        _try_venv()  # re-execs under the venv python; returns only if none exists
        print("veltrix-hijri-date: python package 'hijridate' is not installed "
              "(create the venv: python3 -m venv ~/.local/share/veltrix/venv && "
              "~/.local/share/veltrix/venv/bin/pip install 'hijridate==2.6.0')",
              file=sys.stderr)
        return 3
    shifted = args.gregorian + timedelta(days=args.offset)
    try:
        hijri = Gregorian(shifted.year, shifted.month, shifted.day).to_hijri()
    except Exception as exc:  # date outside the 1343–1500 AH table
        print(f"veltrix-hijri-date: cannot convert {shifted.isoformat()}: {exc}",
              file=sys.stderr)
        return 4
    print(f"{hijri.day} {hijri.month_name()} {hijri.year}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
