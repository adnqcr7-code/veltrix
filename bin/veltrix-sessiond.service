[Unit]
Description=Veltrix session services
Documentation=https://github.com/adnqcr7-code/veltrix
PartOf=graphical-session.target
After=graphical-session.target
Before=veltrix-rust-shell.service
Conflicts=veltrix-sessiond-legacy.service
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=dbus
BusName=org.veltrix.Session
# No flags means all Rust session services (#1017).
ExecStart=/usr/bin/veltrix-sessiond
Restart=on-failure
RestartSec=1
TimeoutStopSec=3
Slice=session-graphical.slice

# NOTE: intentionally NO [Install]/WantedBy=graphical-session.target, for the
# same reason as veltrix.service: plain uwsm Hyprland reaches that generic target
# too. Only Veltrix's compositor configs explicitly start us, before the shell.
# PartOf still stops us on logout. No org.freedesktop.Notifications activation
# file: that would start our notification server in somebody else's desktop.
