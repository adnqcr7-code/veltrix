#!/usr/bin/env python3
# ─────────────────────────────────────────────────────────────────────────────
# veltrix-bug-report — collect a bug report and open a pre-filled GitHub issue.
#
#   veltrix-bug-report [--title TEXT] [--open|--no-open] [--out DIR]
#
# What it does: gathers the version, the session, `veltrix-doctor --log` and
# the recent CRITICAL lines from the shell log; writes a Markdown report to
# ~/Downloads/veltrix-bug-report-<date>.md; prints a pre-filled GitHub issue
# URL (title + a SHORT body — summary, version, "full log attached") and,
# unless --no-open, opens it in the browser with xdg-open.
#
# What it deliberately does NOT do: file the issue itself. There is no
# token anywhere in this script, no API call, and nothing is sent anywhere
# without the user looking at it first. That is a safety decision, not a
# missing feature: a GitHub token baked into the OS would be a credential
# sitting in a world-readable system image — any compromised component (a
# bad update, a malicious app, a bug in the updater) could read it and
# file, edit or spam issues as the project. And a silent auto-send would
# file logs the user never reviewed, which can contain home-directory
# paths, app names and network names. So the flow is: collect locally,
# the user reviews the file, the user taps send in the browser. The URL
# body stays short on purpose (well under URL length limits); the full
# log lives in the report FILE the user attaches, not in the URL.
#
# Test overrides: none needed — HOME, XDG_RUNTIME_DIR and PATH are enough
# (the version comes from ~/.config/veltrix/.dev or /usr/share/veltrix,
# the log from $XDG_RUNTIME_DIR/veltrix-ui.log, the doctor and the opener
# from PATH). See scripts/dev/bug-report-probe.sh.
# ─────────────────────────────────────────────────────────────────────────────
import argparse
import datetime
import os
import re
import shutil
import subprocess
import sys
import urllib.parse

REPO = "adnqcr7-code/veltrix"
ISSUE_URL = f"https://github.com/{REPO}/issues/new"
LOG_NAME = "veltrix-ui.log"
MAX_URL_CHARS = 2000
MAX_TITLE_CHARS = 100
MAX_BODY_CHARS = 800


def _read_first_line(path):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            return f.readline().strip()
    except OSError:
        return None


def version_info():
    """(version, release) — dev checkout first, then the system install."""
    home = os.path.expanduser("~")
    config_dir = os.environ.get("XDG_CONFIG_HOME") or os.path.join(home, ".config")
    veltrix_config = os.path.join(config_dir, "veltrix")
    version = None
    dev_marker = os.path.join(veltrix_config, ".dev")
    repo = _read_first_line(dev_marker)
    if repo:
        version = _read_first_line(os.path.join(repo, "VERSION"))
        if version:
            version = f"{version} (dev checkout: {repo})"
    if not version:
        version = _read_first_line("/usr/share/veltrix/VERSION")
        if version:
            version = f"{version} (system install)"
    release = _read_first_line(os.path.join(veltrix_config, ".release"))
    return version or "n/a", release or "n/a"


def session_info():
    desktop = (
        os.environ.get("XDG_CURRENT_DESKTOP")
        or os.environ.get("XDG_SESSION_DESKTOP")
        or os.environ.get("DESKTOP_SESSION")
        or "n/a"
    )
    compositor = "n/a"
    if os.environ.get("HYALO_SOCKET") or shutil.which("veltrix-hyalo"):
        compositor = "Hyalo"
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        compositor = "Hyprland" if compositor == "n/a" else f"{compositor} + Hyprland"
    return desktop, compositor


def log_path():
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    candidate = os.path.join(runtime, LOG_NAME)
    if os.path.isfile(candidate):
        return candidate
    fallback = os.path.join("/tmp", LOG_NAME)
    return fallback if os.path.isfile(fallback) else candidate


def mask(line, home):
    """Hide home directories and hex addresses; keep the message readable."""
    if home and home != "/":
        line = line.replace(home, "~")
    # Any /home/<user> — not just this user's — is personal. Mask them all.
    line = re.sub(r"/home/[^/\s]+", "~", line)
    line = re.sub(r"0x[0-9a-fA-F]+", "0x…", line)
    return line.rstrip()


def doctor_log():
    """The grouped CRITICAL/WARNING kinds, via veltrix-doctor --log."""
    doctor = shutil.which("veltrix-doctor")
    if not doctor:
        return "n/a (veltrix-doctor not found)"
    try:
        out = subprocess.run(
            [doctor, "--log"], capture_output=True, text=True, timeout=30
        )
    except (OSError, subprocess.TimeoutExpired):
        return "n/a (veltrix-doctor --log failed)"
    text = (out.stdout or "").strip()
    return text if text else "n/a (no log output)"


def recent_criticals(path, home, limit=30):
    """Last CRITICAL lines of the shell log, masked. Empty list if no log."""
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            lines = f.readlines()
    except OSError:
        return []
    found = [mask(l, home) for l in lines if "CRITICAL" in l]
    return found[-limit:]


def build_issue_url(title, body):
    url = f"{ISSUE_URL}?{urllib.parse.urlencode({'title': title, 'body': body})}"
    # Trim the body until the URL fits. The loop (not arithmetic) is what
    # guarantees the bound: urlencode expands "…" to 9 chars, so a computed
    # cut always lands a few chars over.
    while len(url) > MAX_URL_CHARS and len(body) > 1:
        cut = len(url) - MAX_URL_CHARS + 10  # +10 covers the "…" encoding
        body = body[: max(1, len(body) - cut)] + "…"
        url = f"{ISSUE_URL}?{urllib.parse.urlencode({'title': title, 'body': body})}"
    return url


def open_url(url):
    """Best-effort browser open. Returns the opener used, or None."""
    for opener in ("xdg-open", "gio"):
        if shutil.which(opener):
            try:
                args = [opener, url] if opener == "xdg-open" else ["gio", "open", url]
                subprocess.Popen(
                    args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                )
                return opener
            except OSError:
                continue
    return None


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="Collect a bug report and open a pre-filled GitHub issue."
    )
    parser.add_argument("--title", help="issue title (default: from the first CRITICAL kind)")
    parser.add_argument("--open", dest="open", action="store_true", default=True,
                        help="open the pre-filled issue in the browser (default)")
    parser.add_argument("--no-open", dest="open", action="store_false",
                        help="only print the URL, do not open a browser")
    parser.add_argument("--out", help="directory for the report file (default: ~/Downloads)")
    args = parser.parse_args(argv)

    home = os.path.expanduser("~")
    version, release = version_info()
    desktop, compositor = session_info()
    log = log_path()
    kinds = doctor_log()
    criticals = recent_criticals(log, home)

    # The title names the problem: the first critical kind, else a generic one.
    if args.title:
        title = args.title
    elif criticals:
        first = re.sub(r"^\s*\d+\s+", "", criticals[0])
        first = re.sub(r"^(Gjs|Gtk|GLib|Gdk|Gsk)-CRITICAL \*\*: ?", "", first)
        title = f"Bug report: {first.strip()}"
    else:
        title = "Bug report from veltrix-doctor"
    title = title[:MAX_TITLE_CHARS]

    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    out_dir = args.out or os.path.join(home, "Downloads")
    os.makedirs(out_dir, exist_ok=True)
    report_name = f"veltrix-bug-report-{stamp}.md"
    report_path = os.path.join(out_dir, report_name)

    lines = [
        f"# Veltrix bug report ({stamp})",
        "",
        "Collected by `veltrix-bug-report`. Review before posting — paths are",
        "masked to `~`, but read it once anyway.",
        "",
        "## Version",
        "",
        f"- veltrix: {version}",
        f"- release: {release}",
        f"- session: {desktop} / {compositor}",
        "",
        "## Shell log since the last start (`veltrix-doctor --log`)",
        "",
        "```",
        kinds,
        "```",
        "",
        f"## Recent CRITICAL lines ({log})",
        "",
    ]
    if criticals:
        lines.append("```")
        lines.extend(criticals)
        lines.append("```")
    else:
        lines.append("_none found_")
    lines.append("")
    report = "\n".join(lines)
    try:
        with open(report_path, "w", encoding="utf-8") as f:
            f.write(report)
    except OSError as e:
        print(f"veltrix-bug-report: cannot write {report_path}: {e}", file=sys.stderr)
        return 1

    body = (
        f"Veltrix {version} ({desktop} / {compositor}).\n"
        f"{title}\n\n"
        f"Full log attached: {report_name} (see the attached file).\n"
        "Filed with veltrix-bug-report; reviewed before sending."
    )[:MAX_BODY_CHARS]
    url = build_issue_url(title, body)

    print(f"Report written to: {report_path}")
    print(f"Issue URL: {url}")
    if args.open:
        opener = open_url(url)
        if opener:
            print(f"Opened in the browser via {opener} — attach {report_name} and send.")
        else:
            print("No browser opener found (xdg-open/gio) — open the URL above by hand.")
    else:
        print(f"Attach {report_name} to the issue and send.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
