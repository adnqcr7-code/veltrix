case "${1-}" in up) direction=1 ;; down) direction=-1 ;; *) exit 2 ;; esac
exec gdbus call --session --timeout 7 --dest org.veltrix.Session \
    --object-path /org/veltrix/Power --method org.veltrix.Power1.StepPrimaryKeyboardBrightness -- "$direction"
