[Unit]
Description=Veltrix Rust shell (bar, dock and panels)
Documentation=https://github.com/adnqcr7-code/veltrix
PartOf=graphical-session.target
Requires=veltrix-sessiond.service
After=graphical-session.target veltrix-sessiond.service
Conflicts=veltrix.service veltrix-dock.service
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=/usr/bin/veltrix-migrate
ExecStart=/usr/bin/veltrix-shell --bar
Environment=VELTRIX_SESSION=rust
Restart=on-failure
RestartSec=1
TimeoutStopSec=3
Slice=session-graphical.slice

# No WantedBy: only the Veltrix Hyalo launcher starts this unit.
