[Unit]
Description=Veltrix native dock (Hyalo preview)
Documentation=https://github.com/adnqcr7-code/veltrix
PartOf=graphical-session.target
Wants=veltrix-sessiond.service
After=graphical-session.target veltrix-sessiond.service
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/veltrix-shell
Restart=on-failure
RestartSec=1
TimeoutStopSec=3
Slice=session-graphical.slice

# NOTE: no [Install]. Only /usr/lib/veltrix-hyalo/start-shell starts it, and only with
# org.veltrix.dock native-preview on — the TS shell then draws no dock (#959, until D4).
